# Conexión a Neon (pooler) — la usa la aplicación en runtime
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# Conexión directa a Neon — la usa el CLI de Prisma para migraciones
DATABASE_URL_UNPOOLED="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require"

# Secret para Auth.js (generar con: npx auth secret)
AUTH_SECRET=""

# Necesario para desarrollo local fuera de Vercel
AUTH_TRUST_HOST="true"
